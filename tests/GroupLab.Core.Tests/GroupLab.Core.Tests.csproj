<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- PDFtoImage marks its API per operating system; the tests rasterise on whichever one runs them. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GroupLab.Core\GroupLab.Core.csproj" />
    <ProjectReference Include="..\..\src\GroupLab.Cli\GroupLab.Cli.csproj" />
  </ItemGroup>

  <!-- Shared by both test projects: a cleanup that cannot delete must never fail a test. -->
  <ItemGroup>
    <Compile Include="..\Shared\Temp.cs" Link="Support\Temp.cs" />
    <Compile Include="..\Shared\TestTempRoot.cs" Link="Support\TestTempRoot.cs" />
  </ItemGroup>

</Project>
