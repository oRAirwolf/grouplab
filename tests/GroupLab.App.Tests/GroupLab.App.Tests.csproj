<Project Sdk="Microsoft.NET.Sdk">

  <!-- The marking screen driven headlessly: Avalonia.Headless.XUnit runs on xunit v3, so these tests have their own project. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GroupLab.App\GroupLab.App.csproj" />
  </ItemGroup>

  <!-- Shared by both test projects: a cleanup that cannot delete must never fail a test. -->
  <ItemGroup>
    <Compile Include="..\Shared\Temp.cs" Link="Support\Temp.cs" />
    <Compile Include="..\Shared\TestTempRoot.cs" Link="Support\TestTempRoot.cs" />
  </ItemGroup>

</Project>
