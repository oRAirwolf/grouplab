<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <!-- Entry 219 item A3: the network, for error reports and targets the person has agreed to send. Item A4: the camera, asked for the
       first time Take a picture is pressed, never at start. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <!-- Entry 234: the label and whether it can be debugged come from the build, so the development build, org.grouplab.app.dev, is "GroupLab
       Dev" and debuggable beside the Play copy; the provider's authority follows the application id for the same reason. -->
  <application android:label="${grouplabLabel}" android:debuggable="${grouplabDebuggable}" android:icon="${grouplabIcon}" android:resizeableActivity="true" android:allowBackup="false">
    <!-- Entry 219 item A5: session files handed to the share sheet, from the cache's shared folder only. -->
    <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false"
              android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
    </provider>
  </application>
</manifest>
