<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <!-- Entry 219 item A3: the network, for error reports and targets the person has agreed to send. Item A4: the camera, asked for the
       first time Take a picture is pressed, never at start. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- Request 73: printing to a paired label printer over classic Bluetooth, asked the first time Print is pressed. -->
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <!-- Entry 386: finding a Bluetooth LE label printer such as the M220 that is not paired, Android 12 and later, never for location. -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
  <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <!-- Entry 234: the label and whether it can be debugged come from the build, so the development build, org.grouplab.app.dev, is "GroupLab
       Dev" and debuggable beside the Play copy; the provider's authority follows the application id for the same reason. -->
  <application android:label="${grouplabLabel}" android:debuggable="${grouplabDebuggable}" android:icon="${grouplabIcon}" android:roundIcon="${grouplabRoundIcon}" android:resizeableActivity="true" android:allowBackup="false">
    <!-- Entry 219 item A5: session files handed to the share sheet, from the cache's shared folder only. -->
    <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false"
              android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
    </provider>
    <!-- Entry 292 section 1.1: asks Google Play services to add the system photo picker to a phone whose Android is too old to have it; the
         service itself is never run, and a phone without Google Play services gets the apps that offer pictures instead. -->
    <service android:name="com.google.android.gms.metadata.ModuleDependencies" android:enabled="false" android:exported="false">
      <intent-filter>
        <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
      </intent-filter>
      <meta-data android:name="photopicker_activity:0:required" android:value="" />
    </service>
  </application>
</manifest>
