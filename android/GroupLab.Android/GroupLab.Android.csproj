<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOTES-FROM-PLANNING.md entry 219 item A3: the Android application itself, org.grouplab.app, the id it keeps on Google Play for good
    (entry 198 section 1.3). It shares the desktop's engine through GroupLab.Core and the desktop's settings, error report and sharing
    code by compiling those files as they are, so the two cannot drift. Not in GroupLab.slnx: the desktop never needs the Android
    workload. .github/workflows/android.yml builds it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 10, the minimum approved in entry 207. -->
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <ApplicationId>org.grouplab.app</ApplicationId>
    <ApplicationTitle>GroupLab</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RootNamespace>GroupLab.Android</RootNamespace>
    <AndroidManifestPlaceholders>grouplabLabel=GroupLab;grouplabDebuggable=false;grouplabIcon=@mipmap/ic_launcher;grouplabRoundIcon=@mipmap/ic_launcher_round</AndroidManifestPlaceholders>
  </PropertyGroup>

  <!--
    NOTES-FROM-PLANNING.md entry 234: the development build, with -p:GroupLabDev=true. Its own id, so it installs beside the copy from Google
    Play and neither replaces the other; its own name and icon on the home screen; debuggable, so adb shell run-as reaches its log and files.
    The nightly builds it as grouplab-android-dev.apk. Its version ends in -dev, which marks its error and survey reports.
  -->
  <PropertyGroup Condition="'$(GroupLabDev)' == 'true'">
    <ApplicationId>org.grouplab.app.dev</ApplicationId>
    <ApplicationTitle>GroupLab Dev</ApplicationTitle>
    <AndroidManifestPlaceholders>grouplabLabel=GroupLab Dev;grouplabDebuggable=true;grouplabIcon=@mipmap/ic_launcher_dev;grouplabRoundIcon=@mipmap/ic_launcher_dev_round</AndroidManifestPlaceholders>
    <DefineConstants>$(DefineConstants);GROUPLAB_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <!-- Entry 219 item A4: the camera, through CameraX, as the spike measured it. -->
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entry 243 section 3.4: the desktop's library code is compiled here, and its Orientation is the sheet's, not Android's widget one. -->
    <Using Remove="Android.Widget" />
    <Using Remove="Android.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GroupLab.Core\GroupLab.Core.csproj" />
    <!-- The engine's imaging, and the desktop's settings, sharing words and error report code, compiled here as they are. -->
    <Compile Include="..\..\src\GroupLab.Cli\Imaging\*.cs" LinkBase="Shared\Imaging" />
    <!-- Entry 243 section 3.4: the Targets screen's "Made for your optic", the desktop's generator and the layout rules it designs with. -->
    <Compile Include="..\..\src\GroupLab.Cli\Library\TargetGenerator.cs" Link="Shared\Library\TargetGenerator.cs" />
    <Compile Include="..\..\src\GroupLab.Cli\Library\ParametricSheet.cs" Link="Shared\Library\ParametricSheet.cs" />
    <Compile Include="..\..\src\GroupLab.Cli\Library\LibraryBuilder.cs" Link="Shared\Library\LibraryBuilder.cs" />
    <Compile Include="..\..\src\GroupLab.App\AppSettings.cs" Link="Shared\AppSettings.cs" />
    <Compile Include="..\..\src\GroupLab.App\UnitTap.cs" Link="Shared\UnitTap.cs" />
    <Compile Include="..\..\src\GroupLab.App\SharingWords.cs" Link="Shared\SharingWords.cs" />
    <Compile Include="..\..\src\GroupLab.App\SurveyQueue.cs" Link="Shared\SurveyQueue.cs" />
    <Compile Include="..\..\src\GroupLab.App\BenchmarkPanel.cs" Link="Shared\BenchmarkPanel.cs" />
    <Compile Include="..\..\src\GroupLab.App\CompositePlot.cs" Link="Shared\CompositePlot.cs" />
    <Compile Include="..\..\src\GroupLab.App\ShotsCurve.cs" Link="Shared\ShotsCurve.cs" />
    <Compile Include="..\..\src\GroupLab.App\IntervalChart.cs" Link="Shared\IntervalChart.cs" />
    <Compile Include="..\..\src\GroupLab.App\HitGraphs.cs" Link="Shared\HitGraphs.cs" />
    <Compile Include="..\..\src\GroupLab.App\TrajectoryGraph.cs" Link="Shared\TrajectoryGraph.cs" />
    <Compile Include="..\..\src\GroupLab.App\Theme\Tokens.cs" Link="Shared\Theme\Tokens.cs" />
    <Compile Include="..\..\src\GroupLab.App\Theme\Marks.cs" Link="Shared\Theme\Marks.cs" />
    <!-- Entry 246, look B: the desktop's styles, icons and faces, so the phone's colors and type come from the same tokens. -->
    <Compile Include="..\..\src\GroupLab.App\Theme\AppStyles.cs" Link="Shared\Theme\AppStyles.cs" />
    <Compile Include="..\..\src\GroupLab.App\Theme\Icons.cs" Link="Shared\Theme\Icons.cs" />
    <AvaloniaResource Include="..\..\src\GroupLab.App\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\ErrorReports.cs" Link="Shared\Diagnostics\ErrorReports.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\DiagnosticLog.cs" Link="Shared\Diagnostics\DiagnosticLog.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\AppInfo.cs" Link="Shared\Diagnostics\AppInfo.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\LogDirectory.cs" Link="Shared\Diagnostics\LogDirectory.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\ErrorQueue.cs" Link="Shared\Diagnostics\ErrorQueue.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\CrashReporter.cs" Link="Shared\Diagnostics\CrashReporter.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\ReportPackage.cs" Link="Shared\Diagnostics\ReportPackage.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\ImageFacts.cs" Link="Shared\Diagnostics\ImageFacts.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenCV built for the phone by android/opencv/build-extern.sh; CI and a local build put it in android/native. -->
    <AndroidNativeLibrary Include="..\native\arm64-v8a\libOpenCvSharpExtern.so" Condition="Exists('..\native\arm64-v8a\libOpenCvSharpExtern.so')" />
    <AndroidAsset Include="..\..\targets\*.gltd.json" Link="Assets\targets\%(Filename)%(Extension)" />
    <!-- Entry 226 section 1: the definitions sheets were printed from before a redesign, so an old printout is still identified. -->
    <AndroidAsset Include="..\..\targets\frozen\**\*.gltd.json" Link="Assets\targets\frozen\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
