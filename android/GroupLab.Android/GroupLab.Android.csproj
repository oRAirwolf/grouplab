<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOTES-FROM-PLANNING.md entry 219 item A3: the Android application itself, org.grouplab.app, the id it keeps on Google Play for good
    (entry 198 section 1.3). It shares the desktop's engine through GroupLab.Core and the desktop's settings, error report and sharing
    code by compiling those files as they are, so the two cannot drift. Not in GroupLab.slnx: the desktop never needs the Android
    workload. .github/workflows/android.yml builds it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 10, the minimum approved in entry 207. -->
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <ApplicationId>org.grouplab.app</ApplicationId>
    <ApplicationTitle>GroupLab</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RootNamespace>GroupLab.Android</RootNamespace>
    <AndroidManifestPlaceholders>grouplabLabel=GroupLab;grouplabDebuggable=false;grouplabIcon=@mipmap/ic_launcher;grouplabRoundIcon=@mipmap/ic_launcher_round</AndroidManifestPlaceholders>
  </PropertyGroup>

  <!--
    NOTES-FROM-PLANNING.md entry 234: the development build, with -p:GroupLabDev=true. Its own id, so it installs beside the copy from Google
    Play and neither replaces the other; its own name and icon on the home screen; debuggable, so adb shell run-as reaches its log and files.
    The nightly builds it as grouplab-android-dev.apk. Its version ends in -dev, which marks its error and survey reports.
  -->
  <PropertyGroup Condition="'$(GroupLabDev)' == 'true'">
    <ApplicationId>org.grouplab.app.dev</ApplicationId>
    <ApplicationTitle>GroupLab Dev</ApplicationTitle>
    <AndroidManifestPlaceholders>grouplabLabel=GroupLab Dev;grouplabDebuggable=true;grouplabIcon=@mipmap/ic_launcher_dev;grouplabRoundIcon=@mipmap/ic_launcher_dev_round</AndroidManifestPlaceholders>
    <DefineConstants>$(DefineConstants);GROUPLAB_DEV</DefineConstants>
  </PropertyGroup>

  <!--
    NOTES-FROM-PLANNING.md entry 288: the updater lives in its own flavor, -p:GroupLabUpdater=true, on by default for GroupLab Dev's APK and
    for nothing else yet (the sideloaded org.grouplab.app comes later). Without it the Updates folder, WorkManager and the permission to
    install packages are not in the build at all, and an AAB, which only ever goes to Google Play, is refused if it would carry them.
    UpdaterFlavorTests holds this, and the nightly checks the published AAB's manifest.
  -->
  <PropertyGroup>
    <GroupLabUpdater Condition="'$(GroupLabUpdater)' == '' and '$(GroupLabDev)' == 'true' and '$(AndroidPackageFormat)' != 'aab'">true</GroupLabUpdater>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GroupLabUpdater)' == 'true'">
    <DefineConstants>$(DefineConstants);GROUPLAB_UPDATER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(GroupLabUpdater)' != 'true'">
    <Compile Remove="Updates\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(GroupLabUpdater)' == 'true'">
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.2.1" />
  </ItemGroup>
  <Target Name="NoUpdaterInAnAab" BeforeTargets="Build" Condition="'$(GroupLabUpdater)' == 'true' and '$(AndroidPackageFormat)' == 'aab'">
    <Error Text="Entry 288: an AAB goes only to Google Play and must never carry the updater. Build it without -p:GroupLabUpdater=true." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <!-- Entry 219 item A4: the camera, through CameraX, as the spike measured it. -->
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entry 243 section 3.4: the desktop's library code is compiled here, and its Orientation is the sheet's, not Android's widget one. -->
    <Using Remove="Android.Widget" />
    <Using Remove="Android.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Entry 290 section 2 item 1: the phone's screens, and the desktop files they compile, are the shared mobile project's, which the
      iOS head links too. This head keeps only what is Android's own: the activity, the camera, printing, sharing and the updater.
    -->
    <ProjectReference Include="..\..\mobile\GroupLab.Mobile\GroupLab.Mobile.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenCV built for the phone by android/opencv/build-extern.sh; CI and a local build put it in android/native. -->
    <AndroidNativeLibrary Include="..\native\arm64-v8a\libOpenCvSharpExtern.so" Condition="Exists('..\native\arm64-v8a\libOpenCvSharpExtern.so')" />
    <AndroidAsset Include="..\..\targets\*.gltd.json" Link="Assets\targets\%(Filename)%(Extension)" />
    <!-- Entry 226 section 1: the definitions sheets were printed from before a redesign, so an old printout is still identified. -->
    <AndroidAsset Include="..\..\targets\frozen\**\*.gltd.json" Link="Assets\targets\frozen\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
