<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The application shell of docs/PHASE1-BRIEF.md section 6, on Avalonia (GPL-compatible, MIT licensed). The OpenCV imaging
    backend lives in GroupLab.Cli, so the shell references it rather than moving it in this milestone.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GroupLab.App</RootNamespace>
    <!--
      The shell reads the system's region to default the units on first run (NOTES-FROM-PLANNING.md entry 25 section 1), which
      invariant globalization hides. Every number is still formatted and parsed with the invariant culture.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Entry 105 section 5: the executable's icon, drawn from the mark by `grouplab icons`, never exported by hand. -->
    <ApplicationIcon>Assets\icons\grouplab.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GroupLab.Core\GroupLab.Core.csproj" />
    <ProjectReference Include="..\GroupLab.Cli\GroupLab.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GroupLab.App.Tests" />
  </ItemGroup>

  <!--
    IBM Plex Sans, Sans Condensed and Mono, embedded so the type the concept screens were drawn in is the type every user sees, and a
    missing face cannot silently change a measurement column (NOTES-FROM-PLANNING.md entry 42 section 3). The SIL Open Font License asks
    that every copy carry the licence, so it ships beside the application too.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- GroupLab's mark and lockup, entry 105 section 4: the committed SVGs are the source, drawn by BrandMark. -->
    <AvaloniaResource Include="Assets\grouplab-*.svg" />
    <AvaloniaResource Include="Assets\icons\grouplab.ico" />
    <None Include="Assets\Fonts\LICENSE.txt" Link="IBM-Plex-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The built-in library ships beside the application, for the print screen (NOTES-FROM-PLANNING.md entry 25 section 2). -->
  <ItemGroup>
    <None Include="..\..\targets\*.gltd.json" Link="targets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The frozen definitions the Phase 0 sheets were printed from, so the codes on those sheets name a definition the application has
         (NOTES-FROM-PLANNING.md entry 35 section 6 item 3). They sit below targets, where the print screen's list does not look. -->
    <None Include="..\..\targets\frozen\**\*.gltd.json" Link="targets\frozen\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    NOTES-FROM-PLANNING.md entry 132 section 2 and entry 133: the published build carried 100.7 MB of debug symbols, and 100 MB of that was
    two files, libSkiaSharp.pdb at 80.1 MB and libHarfBuzzSharp.pdb at 19.9 MB. Those are native symbols for Skia and HarfBuzz. Nothing at
    runtime reads them, no crash report this project writes can use them, and no user of GroupLab will ever open them in a debugger.

    They were a third of the installed size and a large part of the 97 MB download, for nothing at all. GroupLab's own symbols stay, because
    a crash record naming a line in GroupLab is worth having and they cost a few hundred kilobytes between them.
  -->
  <Target Name="LeaveOutNativeDebugSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' and !$([System.String]::Copy('%(Filename)').StartsWith('GroupLab'))" />
    </ItemGroup>
  </Target>

</Project>
