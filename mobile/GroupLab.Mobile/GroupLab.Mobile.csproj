<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOTES-FROM-PLANNING.md entry 290 section 2 item 1: the phone's screens, once, for both heads. It is a plain .NET library with no Android
    or iOS in it, so it builds and is tested on any machine, and the Android head (android/GroupLab.Android) and the iOS head
    (ios/GroupLab.iOS) each link it and answer IPhonePlatform. It shares the desktop's engine through GroupLab.Core and the desktop's
    settings, error report and sharing code by compiling those files as they are, so the phone and the desktop cannot drift.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GroupLab.Mobile</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The desktop files compiled here leave out what only the desktop window has, such as the update handover's screen. -->
    <DefineConstants>$(DefineConstants);GROUPLAB_MOBILE</DefineConstants>
  </PropertyGroup>

  <!-- GroupLab Dev's test hooks (entry 246), in the development build only, as they were in the Android head. -->
  <PropertyGroup Condition="'$(GroupLabDev)' == 'true'">
    <DefineConstants>$(DefineConstants);GROUPLAB_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GroupLab.Android" />
    <InternalsVisibleTo Include="GroupLab.iOS" />
    <!-- Entry 290 section 2 item 4: the desktop side of the iOS self-test, which runs the head's checks against the same code. -->
    <InternalsVisibleTo Include="GroupLab.iOS.SelfTestReference" />
    <InternalsVisibleTo Include="GroupLab.App.Tests" />
    <InternalsVisibleTo Include="GroupLab.Core.Tests" />
    <InternalsVisibleTo Include="GroupLab.Mobile.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GroupLab.Core\GroupLab.Core.csproj" />
    <!-- The engine's imaging, and the desktop's settings, sharing words and error report code, compiled here as they are. -->
    <Compile Include="..\..\src\GroupLab.Cli\Imaging\*.cs" LinkBase="Shared\Imaging" />
    <!-- Entry 243 section 3.4: the Targets screen's "Made for your optic", the desktop's generator and the layout rules it designs with. -->
    <Compile Include="..\..\src\GroupLab.Cli\Library\TargetGenerator.cs" Link="Shared\Library\TargetGenerator.cs" />
    <Compile Include="..\..\src\GroupLab.Cli\Library\ParametricSheet.cs" Link="Shared\Library\ParametricSheet.cs" />
    <Compile Include="..\..\src\GroupLab.Cli\Library\LibraryBuilder.cs" Link="Shared\Library\LibraryBuilder.cs" />
    <Compile Include="..\..\src\GroupLab.App\AppSettings.cs" Link="Shared\AppSettings.cs" />
    <Compile Include="..\..\src\GroupLab.App\UnitTap.cs" Link="Shared\UnitTap.cs" />
    <Compile Include="..\..\src\GroupLab.App\SharingWords.cs" Link="Shared\SharingWords.cs" />
    <Compile Include="..\..\src\GroupLab.App\MoreFold.cs" Link="Shared\MoreFold.cs" />
    <Compile Include="..\..\src\GroupLab.App\SurveyQueue.cs" Link="Shared\SurveyQueue.cs" />
    <Compile Include="..\..\src\GroupLab.App\BenchmarkPanel.cs" Link="Shared\BenchmarkPanel.cs" />
    <Compile Include="..\..\src\GroupLab.App\CompositePlot.cs" Link="Shared\CompositePlot.cs" />
    <!-- Entry 280 section 2, Share A: the picture with its results box, the same control as the desktop's window. -->
    <Compile Include="..\..\src\GroupLab.App\SharePicture.cs" Link="Shared\SharePicture.cs" />
    <Compile Include="..\..\src\GroupLab.App\ShotsCurve.cs" Link="Shared\ShotsCurve.cs" />
    <Compile Include="..\..\src\GroupLab.App\IntervalChart.cs" Link="Shared\IntervalChart.cs" />
    <Compile Include="..\..\src\GroupLab.App\HitGraphs.cs" Link="Shared\HitGraphs.cs" />
    <Compile Include="..\..\src\GroupLab.App\TrajectoryGraph.cs" Link="Shared\TrajectoryGraph.cs" />
    <Compile Include="..\..\src\GroupLab.App\Theme\Tokens.cs" Link="Shared\Theme\Tokens.cs" />
    <Compile Include="..\..\src\GroupLab.App\Theme\Marks.cs" Link="Shared\Theme\Marks.cs" />
    <!-- Entry 246, look B: the desktop's styles, icons and faces, so the phone's colors and type come from the same tokens. -->
    <Compile Include="..\..\src\GroupLab.App\Theme\AppStyles.cs" Link="Shared\Theme\AppStyles.cs" />
    <Compile Include="..\..\src\GroupLab.App\Theme\Icons.cs" Link="Shared\Theme\Icons.cs" />
    <AvaloniaResource Include="..\..\src\GroupLab.App\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\ErrorReports.cs" Link="Shared\Diagnostics\ErrorReports.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\DiagnosticLog.cs" Link="Shared\Diagnostics\DiagnosticLog.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\AppInfo.cs" Link="Shared\Diagnostics\AppInfo.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\LogDirectory.cs" Link="Shared\Diagnostics\LogDirectory.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\ErrorQueue.cs" Link="Shared\Diagnostics\ErrorQueue.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\CrashReporter.cs" Link="Shared\Diagnostics\CrashReporter.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\ReportPackage.cs" Link="Shared\Diagnostics\ReportPackage.cs" />
    <Compile Include="..\..\src\GroupLab.App\Diagnostics\ImageFacts.cs" Link="Shared\Diagnostics\ImageFacts.cs" />
  </ItemGroup>

</Project>
