{ "name": "the phone's published screenshots: before you start, capture, targets, scale markers, a store-bought target, settings, a result, pairing readings, the open targets and sessions", "stopOnFailure": false, "caliber": "6.5 Creedmoor", "distanceInches": 3600,
  "steps": [
    { "do": "reset", "firstRun": "ask" },
    { "do": "sleep", "seconds": 2 },
    { "do": "screenshot", "name": "firstrun" },
    { "do": "reset" },
    { "do": "sleep", "seconds": 2 },
    { "do": "open", "place": "capture" },
    { "do": "sleep", "seconds": 2 },
    { "do": "screenshot", "name": "capture" },
    { "do": "open", "place": "targets" },
    { "do": "sleep", "seconds": 2 },
    { "do": "screenshot", "name": "targets" },
    { "do": "open", "place": "targets" },
    { "do": "sleep", "seconds": 2 },
    { "do": "scroll", "name": "Scale markers", "to": "top" },
    { "do": "sleep", "seconds": 1 },
    { "do": "screenshot", "name": "scale-markers" },
    { "do": "scroll", "to": "top" },
    { "do": "press", "name": "targets-add-store" },
    { "do": "pick", "file": "stand-in-poster.jpg", "seconds": 300 },
    { "do": "sleep", "seconds": 2 },
    { "do": "press", "name": "fingerprint-next" },
    { "do": "wait", "text": "How big is this target?", "seconds": 60 },
    { "do": "type", "name": "fingerprint-width", "text": "12" },
    { "do": "type", "name": "fingerprint-height", "text": "18" },
    { "do": "sleep", "seconds": 1 },
    { "do": "screenshot", "name": "fingerprint" },
    { "do": "open", "place": "settings" },
    { "do": "sleep", "seconds": 2 },
    { "do": "screenshot", "name": "settings" },
    { "do": "open", "place": "capture" },
    { "do": "picture", "file": "sample.png" },
    { "do": "wait", "screen": "FeedbackView|ResultView", "seconds": 300 },
    { "do": "press", "name": "Use this picture|Use it anyway" },
    { "do": "wait", "screen": "ResultView", "seconds": 180 },
    { "do": "sleep", "seconds": 3 },
    { "do": "screenshot", "name": "result" },
    { "do": "scroll", "name": "Add readings" },
    { "do": "press", "name": "Add readings" },
    { "do": "wait", "text": "Chronograph readings", "seconds": 30 },
    { "do": "type", "name": "chrono-readings", "text": "2711, 2697, 2697, 2697, 2707, 2712, 2691, 2707, 2688, 2700, 2693, 2692, 2697, 2693, 2699, 2692, 2710, 2706, 2706, 2688, 2688, 2692, 2690, 2711, 2710" },
    { "do": "press", "name": "chrono-read" },
    { "do": "wait", "screen": "PairingView", "seconds": 30 },
    { "do": "sleep", "seconds": 1 },
    { "do": "screenshot", "name": "pairing" },
    { "do": "press", "name": "chrono-pairing-back" },
    { "do": "press", "name": "Back" },
    { "do": "scroll", "to": "top" },
    { "do": "press", "name": "result-open-targets" },
    { "do": "press", "name": "open-targets-another" },
    { "do": "picture", "file": "sample.png" },
    { "do": "wait", "screen": "FeedbackView|ResultView", "seconds": 300 },
    { "do": "press", "name": "Use this picture|Use it anyway" },
    { "do": "wait", "text": "2 open", "seconds": 300 },
    { "do": "sleep", "seconds": 2 },
    { "do": "press", "name": "result-open-targets" },
    { "do": "sleep", "seconds": 1 },
    { "do": "screenshot", "name": "open-targets" },
    { "do": "open", "place": "sessions" },
    { "do": "sleep", "seconds": 2 },
    { "do": "screenshot", "name": "sessions" } ] }
