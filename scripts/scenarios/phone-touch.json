{ "name": "real taps: the buttons TestFlight build 157 left dead on the iPhone", "stopOnFailure": false, "caliber": "",
  "steps": [
    { "do": "open", "place": "capture" },
    { "do": "sleep", "seconds": 1 },
    { "do": "hold", "tap": "capture-take-picture", "name": "01-take-a-picture-asks-the-caliber" },
    { "do": "expect", "name": "capture-ask-continue", "showing": true },
    { "do": "setting", "name": "shotSetup", "value": { "caliber": "6.5 Creedmoor" } },
    { "do": "hold", "tap": "capture-distance", "name": "02-distance-in-the-question" },
    { "do": "expect", "keyboard": true, "seconds": 10 },
    { "do": "screenshot", "name": "02-keyboard-up" },
    { "do": "hold", "tap": "capture-ask-continue", "name": "03-continue-with-the-keyboard-up" },
    { "do": "expect", "name": "capture-ask-continue", "showing": false, "camera": true, "seconds": 10 },
    { "do": "close" },
    { "do": "sleep", "seconds": 1 },
    { "do": "hold", "tap": "capture-change", "name": "04-change" },
    { "do": "expect", "name": "capture-change", "text": "Done" },
    { "do": "hold", "tap": "capture-distance", "name": "05-distance-on-the-page" },
    { "do": "expect", "keyboard": true, "seconds": 10 },
    { "do": "screenshot", "name": "05-keyboard-up" },
    { "do": "hold", "tap": "capture-change", "name": "06-done-with-the-keyboard-up" },
    { "do": "expect", "name": "capture-change", "text": "Change", "keyboard": false, "seconds": 10 },
    { "do": "hold", "tap": "capture-change", "name": "07-change-again" },
    { "do": "expect", "name": "capture-change", "text": "Done" },
    { "do": "hold", "tap": "capture-distance", "name": "08-distance-again" },
    { "do": "expect", "keyboard": true, "seconds": 10 },
    { "do": "hold", "tap": "capture-take-picture", "name": "09-take-a-picture-with-the-keyboard-up" },
    { "do": "expect", "camera": true, "seconds": 10 },
    { "do": "close" },
    { "do": "sleep", "seconds": 1 },
    { "do": "scroll", "name": "capture-choose-photo" },
    { "do": "hold", "tap": "capture-choose-photo", "name": "10-choose-a-photo" },
    { "do": "expect", "log": "ios.pick|phone.pick", "seconds": 10 },
    { "do": "log", "lines": 400 } ] }
