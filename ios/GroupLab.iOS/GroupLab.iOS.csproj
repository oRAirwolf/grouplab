<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOTES-FROM-PLANNING.md entry 290 section 2 item 3: the iPhone and iPad application, org.grouplab.app, the same id as on Android. The
    screens are the shared mobile project's (mobile/GroupLab.Mobile); this head answers IPhonePlatform with UIKit, ImageIO and OpenCV linked
    statically. Not in GroupLab.slnx: the desktop never needs the iOS workload. .github/workflows/ios-app.yml builds it for the simulator and
    for a device, unsigned until the Apple secrets exist (docs/IOS-PLAN.md section 3).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <!-- Entry 206 section 4 and docs/IOS-PLAN.md: iOS 26, an iPhone 11 or later and the iPad mini (6th generation). -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <ApplicationId>org.grouplab.app</ApplicationId>
    <ApplicationTitle>GroupLab</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <RootNamespace>GroupLab.iOS</RootNamespace>
    <!-- The icon, from the desktop's mark by scripts/ios-icons.py. -->
    <AppIcon>AppIcon</AppIcon>
    <!-- The simulator's build is signed ad hoc, which needs no certificate; a device build is unsigned until the secrets exist (request 55). -->
    <!--
      The trimmer. GroupLab's settings, records, error reports and markings are written with System.Text.Json's reflection, and its build
      stamp is read from assembly metadata, as on the desktop and Android. So only the SDK is trimmed (partial), JSON's reflection stays on,
      and the attribute the build stamp lives in is kept; the analysis of GroupLab's own code for full trimming is not asked for.
    -->
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <_AggressiveAttributeTrimming>false</_AggressiveAttributeTrimming>
    <!--
      OpenCvSharp hands OpenCV a lambda for its error callback when it starts, and iOS compiles everything ahead of time, where a callback
      from native code needs a wrapper made in advance for a method marked for it; this one is not, so OpenCvSharp's start failed with
      "Attempting to JIT compile method (wrapper native-to-managed)". Its assembly, a thin layer of calls into OpenCV, runs in the
      interpreter, which makes that wrapper when it is needed; everything else stays compiled ahead of time.
    -->
    <MtouchInterpreter>OpenCvSharp</MtouchInterpreter>
    <!-- An exception says what went wrong in words, in the log and an error report, rather than a resource key. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- Entry 292 section 2.3: the app group the share extension leaves shared pictures in. -->
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!--
      Entry 290 section 2 item 7: the nightly's signed publish names each project's App Store profile by its own property
      (the properties scripts/ios-signing.py builds), because one CodesignProvision on the command line would reach the share extension too.
    -->
    <CodesignProvision Condition="'$(GroupLabAppProvision)' != ''">$(GroupLabAppProvision)</CodesignProvision>
    <!--
      Entitlements would make the build ask for a provisioning profile even for the simulator, which needs none: there it is signed ad hoc
      with the entitlements in the signature, which is how the simulator grants the app group.
    -->
    <CodesignRequireProvisioningProfile Condition="'$(CodesignRequireProvisioningProfile)' == '' and $(RuntimeIdentifier.StartsWith('iossimulator'))">false</CodesignRequireProvisioningProfile>
  </PropertyGroup>

  <!--
    NOTES-FROM-PLANNING.md entry 315's amendment, sections 2 and 5: GroupLab Dev, with -p:GroupLabDev=true, as on Android. Its own id, name,
    icon, app group and address, so it installs beside GroupLab (the .dev files scripts/ios-dev-app.py makes from this project's own), and
    the developer tools compiled in (GROUPLAB_DEV, which reaches the shared screens through the same property). The public application is
    built without them, and a test holds that it carries none of their types. Sent only to TestFlight's internal group once its profiles
    exist (request 61); built for the simulator by the workflow ios app until then.
  -->
  <PropertyGroup Condition="'$(GroupLabDev)' == 'true'">
    <ApplicationId>org.grouplab.app.dev</ApplicationId>
    <ApplicationTitle>GroupLab Dev</ApplicationTitle>
    <AppIcon>AppIconDev</AppIcon>
    <CodesignEntitlements>Entitlements.dev.plist</CodesignEntitlements>
    <AppBundleManifest>Info.dev.plist</AppBundleManifest>
    <DefineConstants>$(DefineConstants);GROUPLAB_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Entry 307: JSON reads and writes the immutable lists of a data file (the rifles, barrels and loads) through the collection's own
      factory methods, found by reflection, which the SDK's trimming removed; Export all my data stopped with "ImmutableList is not
      supported" on the simulator. The assembly is kept whole.
    -->
    <TrimmerRootAssembly Include="System.Collections.Immutable" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each file names the Apple namespaces it uses, so an Avalonia or OpenCV name is never read as a UIKit one. -->
    <Using Remove="UIKit" />
    <Using Remove="Foundation" />
    <Using Remove="CoreGraphics" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Entry 292 section 2.3: the share extension, built and put in the application's PlugIns folder, and where the two meet. Its assembly
      stays referenced: the iOS workload held here embeds an extension only when it is (dotnet/macios 26453, fixed in a later workload).
    -->
    <ProjectReference Include="..\GroupLab.Share\GroupLab.Share.csproj" IsAppExtension="true" />
    <Compile Include="..\Shared\Handoff.cs" Link="Photos\Handoff.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entry 290 section 2 item 1: the phone's screens, and the desktop files they compile, shared with the Android head. -->
    <ProjectReference Include="..\..\mobile\GroupLab.Mobile\GroupLab.Mobile.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sheets, in the application bundle under targets/ and targets/frozen/, copied into the application's files at first use. -->
    <BundleResource Include="..\..\targets\*.gltd.json" Link="targets\%(Filename)%(Extension)" LogicalName="targets/%(Filename)%(Extension)" />
    <!-- Entry 226 section 1: the definitions sheets were printed from before a redesign, so an old printout is still identified. -->
    <BundleResource Include="..\..\targets\frozen\**\*.gltd.json" Link="targets\frozen\%(Filename)%(Extension)" LogicalName="targets/frozen/%(Filename)%(Extension)" />
    <ImageAsset Include="Assets.xcassets\**\*" />
  </ItemGroup>

  <!--
    OpenCV and OpenCvSharp's native half, built by ios/opencv/build-extern.sh as a static xcframework. CI puts it in ios/native; a build
    without it still compiles and links, and the imaging then says it is missing. OpenCvSharp calls the library by name, and NativeOpenCv
    points that name at the application itself, where this links it.
  -->
  <PropertyGroup>
    <GroupLabOpenCv Condition="'$(GroupLabOpenCv)' == ''">$(MSBuildThisFileDirectory)..\native\OpenCvSharpExtern.xcframework</GroupLabOpenCv>
    <!-- The Apple frameworks and libraries OpenCV's static configuration names (link-frameworks.txt); CI passes what the build wrote. -->
    <GroupLabOpenCvFrameworks Condition="'$(GroupLabOpenCvFrameworks)' == ''">Accelerate CoreFoundation CoreGraphics Foundation</GroupLabOpenCvFrameworks>
    <GroupLabOpenCvLinkerFlags Condition="'$(GroupLabOpenCvLinkerFlags)' == ''">-liconv -lz -lc++</GroupLabOpenCvLinkerFlags>
    <DefineConstants Condition="Exists('$(GroupLabOpenCv)')">$(DefineConstants);GROUPLAB_OPENCV</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(GroupLabOpenCv)')">
    <NativeReference Include="$(GroupLabOpenCv)">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
      <SmartLink>false</SmartLink>
      <Frameworks>$(GroupLabOpenCvFrameworks.Trim())</Frameworks>
      <LinkerFlags>$(GroupLabOpenCvLinkerFlags.Trim())</LinkerFlags>
    </NativeReference>
  </ItemGroup>
  <!--
    The link strips every symbol no P/Invoke it knows of names, and OpenCvSharp's P/Invokes name a library, not __Internal, so its entry
    points are listed for it to keep: ios/opencv-symbols.py writes the list beside the framework.
  -->
  <Import Project="$(GroupLabOpenCv)\..\OpenCvSharpExtern.symbols.props" Condition="Exists('$(GroupLabOpenCv)') and Exists('$(GroupLabOpenCv)\..\OpenCvSharpExtern.symbols.props')" />

</Project>
