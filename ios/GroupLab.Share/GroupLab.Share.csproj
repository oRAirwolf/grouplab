<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOTES-FROM-PLANNING.md entry 292 section 2.3: the share extension, org.grouplab.app.share, so GroupLab is in the share sheet of Google
    Photos, Photos and every other app on iPhone and iPad. It only copies what was shared into the app group and opens GroupLab, which reads
    it (ios/Shared/Handoff.cs); it carries none of GroupLab's own code, so it stays small, as an extension has to. Built inside the
    application by its reference in ios/GroupLab.iOS/GroupLab.iOS.csproj.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <IsAppExtension>true</IsAppExtension>
    <ApplicationId>org.grouplab.app.share</ApplicationId>
    <ApplicationTitle>GroupLab</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <RootNamespace>GroupLab.Share</RootNamespace>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- The extension's own App Store profile in the nightly's signed publish (the properties scripts/ios-signing.py builds). -->
    <CodesignProvision Condition="'$(GroupLabShareProvision)' != ''">$(GroupLabShareProvision)</CodesignProvision>
    <!--
      Entitlements would make the build ask for a provisioning profile even for the simulator, which needs none: there it is signed ad hoc
      with the entitlements in the signature, which is how the simulator grants the app group.
    -->
    <CodesignRequireProvisioningProfile Condition="'$(CodesignRequireProvisioningProfile)' == '' and $(RuntimeIdentifier.StartsWith('iossimulator'))">false</CodesignRequireProvisioningProfile>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <!--
    Entry 315's amendment: GroupLab Dev's share extension, org.grouplab.app.dev.share, with GroupLab Dev's app group and name, from the .dev
    files scripts/ios-dev-app.py makes from this project's own.
  -->
  <PropertyGroup Condition="'$(GroupLabDev)' == 'true'">
    <ApplicationId>org.grouplab.app.dev.share</ApplicationId>
    <ApplicationTitle>GroupLab Dev</ApplicationTitle>
    <CodesignEntitlements>Entitlements.dev.plist</CodesignEntitlements>
    <AppBundleManifest>Info.dev.plist</AppBundleManifest>
    <DefineConstants>$(DefineConstants);GROUPLAB_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="UIKit" />
    <Using Remove="Foundation" />
    <Using Remove="CoreGraphics" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one piece shared with the application: where shared pictures wait and how GroupLab is told. -->
    <Compile Include="..\Shared\Handoff.cs" Link="Handoff.cs" />
  </ItemGroup>

</Project>
