#!/usr/bin/env python3
"""Put the Cloudflare Turnstile secret on the server, NOTES-FROM-PLANNING.md entry 129 section 2.2.

Alan runs this himself, once, in his own SSH session. It asks for the secret with the echo turned
off, writes it where the receiver can read it and nothing else can, and prints nothing back.

    sudo /usr/local/sbin/grouplab-set-turnstile-secret

**The secret never enters this repository, a commit, a log or a report.** It is not passed as an
argument either, because an argument is visible to every process on the machine and lands in the
shell history. It is typed, and it goes straight into a file with mode 600.

The site key is the public half and lives in the page; only this half has to be kept.
"""

from __future__ import annotations

import getpass
import os
import re
import sys
from pathlib import Path

SECRET = Path("/home/airwolf/web/grouplab.org/private/turnstile-secret.txt")

# The PHP pool runs as the site's own user, and nothing else has any business reading this.
OWNER = "airwolf"

# Cloudflare's secrets are of the shape 0x... and a comfortable length. This is a shape check, not
# a validity check: only Cloudflare can say whether a secret works, and the receiver finds out.
SHAPE = re.compile(r"^0x[A-Za-z0-9_-]{20,100}$")


def main() -> int:
    if os.geteuid() != 0:
        print("This has to run as root: sudo /usr/local/sbin/grouplab-set-turnstile-secret")
        return 2

    print("Paste the Cloudflare Turnstile *secret* key for grouplab.org.")
    print("It will not be shown as you type, and it is not written to the shell history.")
    print("The site key is public and belongs in the page, not here.")
    print()

    try:
        secret = getpass.getpass("secret key: ").strip()
    except (EOFError, KeyboardInterrupt):
        print("\nNothing was changed.")
        return 1

    if not secret:
        print("Nothing was typed, so nothing was changed.")
        return 1

    if not SHAPE.match(secret):
        # Said without repeating any of it back.
        print("That does not look like a Turnstile secret key: they begin 0x and are longer than that.")
        print("Nothing was changed.")
        return 1

    SECRET.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(SECRET.parent, 0o750)

    # Written with the right mode from the start, so it is never briefly readable by anybody else.
    fd = os.open(SECRET, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(secret + "\n")

    try:
        import pwd

        uid = pwd.getpwnam(OWNER).pw_uid
        gid = pwd.getpwnam(OWNER).pw_gid
        os.chown(SECRET, uid, gid)
        os.chown(SECRET.parent, uid, gid)
    except (ImportError, KeyError) as e:
        print(f"Written, but the owner could not be set ({e}). Check it by hand:")
        print(f"  sudo ls -l {SECRET}")
        return 1

    print()
    print(f"Written to {SECRET}, owned by {OWNER}, mode 600.")
    print("The upload form will start accepting submissions once the receiver is installed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
