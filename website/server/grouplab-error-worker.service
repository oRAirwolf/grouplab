[Unit]
# NOTES-FROM-PLANNING.md entry 194 section 3.2. Turns the error reports the receiver stored into issues in the private
# repository oRAirwolf/grouplab-crash-reports.
#
# It is not the intake worker on purpose. That one decodes strangers' photographs and has no network at all; this
# one needs api.github.com, and reads nothing but small JSON files the receiver has already cut to their schema.
Description=Turn GroupLab error reports into issues in the private reports repository
Documentation=https://github.com/oRAirwolf/grouplab/blob/main/docs/WEBSITE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/grouplab-error-worker.py
User=airwolf
Group=airwolf

# The token, from a file only root can read, handed to this service and nothing else. It appears in the service's
# credentials folder, never in its environment, its arguments or its log.
LoadCredential=github-token:/etc/grouplab/error-token

# Everything read only except the reports it works through and its log.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/airwolf/web/grouplab.org/private/error-reports
ReadWritePaths=/home/airwolf/logs
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

# The network it needs, and no other kind of socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

MemoryMax=200M
CPUQuota=50%
RuntimeMaxSec=300
TasksMax=16

[Install]
WantedBy=multi-user.target
